{
    "name": "fanatique/simpla",
    "description": "Alexander Thomas <me@alexander-thomas.net>",
    "type": "project",
    "require": {
        "php": "^8.5",
        "suin/php-rss-writer": "^1.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Thomas",
            "email": "me@alexander-thomas.net"
        }
    ],
    "autoload": {
        "psr-4": { "": "src/" }
    },
    "scripts": {
        "setup": "@php app/scripts/setup.php",
        "generate-posts": "@php app/scripts/generate-posts.php",
        "generate-pages": "@php app/scripts/generate-pages.php",
        "generate-post-index": "@php app/scripts/generate-post-index.php",
        "generate-tags": "@php app/scripts/generate-tags.php",
        "generate-feed": "@php app/scripts/generate-feed.php",
        "generate-sitemap": "@php app/scripts/generate-sitemap.php",
        "generate-robots": "@php app/scripts/generate-robots.php",
        "generate-manifest": "@php app/scripts/generate-manifest.php",
        "generate-content": [
            "@generate-posts",
            "@generate-pages",
            "@generate-post-index",
            "@generate-tags",
            "@generate-feed",
            "@generate-sitemap",
            "@generate-robots",
            "@generate-manifest"
        ],
        "copy-assets": "@php app/scripts/copy-assets.php",
        "copy-content-media": "@php app/scripts/copy-content-media.php",
        "build": [
            "@setup",
            "@generate-posts",
            "@generate-pages",
            "@generate-post-index",
            "@generate-tags",
            "@generate-feed",
            "@generate-sitemap",
            "@generate-robots",
            "@generate-manifest",
            "@copy-assets",
            "@copy-content-media"
        ],
        "test": "phpunit --colors=always"
    }
}
