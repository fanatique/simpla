<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<?php
$pageTitle = (is_object($entity) && !is_null($entity->get('title'))) ? $entity->get('title') : null;
$metaDescription = (is_object($entity) && !is_null($entity->get('description'))) ? $entity->get('description') : $config->description;
$ogType = $ogType ?? 'article';
if (is_object($entity)) {
    $slugUrl = $entity->getSlug($config->base_url);
    // Homepage (slug "index") is served from the site root, not /index.html.
    $canonical = ($slugUrl === $config->base_url . '/index')
        ? $config->base_url . '/'
        : $slugUrl . '.' . $config->file_extension_content;
} else {
    $canonical = $config->base_url . '/' . $slug . '.' . $config->file_extension_content;
}
$documentTitle = ($pageTitle ? htmlspecialchars($pageTitle) . ' | ' : '') . htmlspecialchars($config->title);
?>
<title><?= $documentTitle ?></title>
<meta name="description" content="<?= htmlspecialchars($metaDescription) ?>">

<link rel="canonical" href="<?= $canonical ?>" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@exampledev/new.css@1.1.2/new.min.css">
<link rel="stylesheet" href="<?= $config->base_url ?>/css/new.theme.simpla.css">
<?php if (isset($config->manifest)) : ?>
<link rel="manifest" href="<?= $config->base_url ?>/<?= $config->slugs->manifest ?>.<?= $config->file_extension_manifest ?>">
<meta name="theme-color" content="<?= $config->manifest->theme_color ?? '#ffffff' ?>">
<?php endif; ?>
<script src="<?= $config->base_url ?>/js/main.js" defer></script>

<meta property="og:type" content="<?= $ogType ?>" />
<meta property="og:title" content="<?= $documentTitle ?>" />
<meta property="og:description" content="<?= htmlspecialchars($metaDescription) ?>" />
<?php if (is_object($entity) && $entity->get('image') !== null) : ?>
    <meta property="og:image" content="<?= $config->base_url ?>/img/<?= $entity->get('image') ?>" />
<?php endif; ?>
<meta property="og:url" content="<?= $canonical ?>" />

<meta property="og:site_name" content="<?= htmlspecialchars($config->title) ?>" />
